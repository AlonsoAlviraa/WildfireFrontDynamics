{
  "schema": "wfd_global_wildfire_api_registry_v1",
  "as_of": "2026-08-18",
  "scope": "Programmatic data services relevant to wildfire discovery, front reconstruction, spread modelling, validation and decision-support context",
  "collection_policy": {
    "event_driven_not_world_dump": true,
    "max_probe_response_bytes": 262144,
    "default_probe_interval_seconds": 0.25,
    "respect_robots_terms_quotas_and_attribution": true,
    "never_treat_hotspots_as_perimeters": true,
    "never_treat_final_burn_scars_as_temporal_progression": true,
    "never_treat_model_forecasts_as_observations": true,
    "unknown_rights_block_training_and_redistribution": true
  },
  "roles": {
    "event_discovery": "Find a candidate incident; not a training label.",
    "active_fire_observation": "Thermal point/pixel or radiative signal; not a perimeter.",
    "progression_label": "Dated perimeter or fire-edge observation suitable for temporal-pair audit.",
    "eo_input": "Earth-observation imagery or derived raster used as a model input or weak proxy.",
    "weather_input": "Observed, analysed or forecast meteorology; run and valid times must be preserved.",
    "fuel_input": "Vegetation, fuel, soil-moisture or land-cover context.",
    "terrain_input": "Elevation and derived slope/aspect.",
    "impact_context": "Smoke, air quality, population or infrastructure context; not spread ground truth."
  },
  "sources": [
    {
