# Version control
.git
.gitignore
.github

# Python caches & build artifacts
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data & artifacts — too large for image, mount at runtime instead
data/
artifacts/
outputs/
kaggle_output/
fotosPrueba/

# Kaggle jobs (run separately)
kaggle_job/

# Docs (optional in image) — keep root README for packaging (pyproject readme=)
docs/
*.md
!README.md

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scripts not needed in runtime
*.ps1
*.cmd
*.bat